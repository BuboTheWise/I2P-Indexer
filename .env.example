###############################################################################
# I2P Indexer — Per-Feature AI Configuration Template
#
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env
#
# pipeline.sh reads these automatically via shell variable defaults, but
# exporting them explicitly (or sourcing .env) overrides the built-in defaults.
###############################################################################

# ─── Shared Ollama Endpoint ──────────────────────────────────────────────
# All AI features route through this endpoint. Change if Ollama runs on a
# remote host or non-standard port.
export OLLAMA_URL="http://localhost:11434"

# ─── Feature 1: Probe-Sweep Translation ─────────────────────────────────
# Used by probe_sweep.py when it encounters non-English content during
# extraction. Translates page summaries inline as sites are probed.
# Good models: RogerBen/HY-MT2-1.8B (fast, CPU), mistral:7b, any MT model.
export TRANSLATION_MODEL="RogerBen/HY-MT2-1.8B:latest"

# ─── Feature 2: Deep Analysis ────────────────────────────────────────────
# Used by src/deep_analysis.py to classify sites, score interest level,
# and tag content categories. Needs a model with good reasoning (not just MT).
# Good models: RogerBen/HY-MT2-1.8B, llama3.2, mistral:7b.
export ANALYSIS_MODEL="RogerBen/HY-MT2-1.8B:latest"

# ─── Feature 3: Summary Translation (Batch) ──────────────────────────────
# Used by translate_summaries.py (Layer 2 batch pass). Separate from probe
# translation so you can use different models — e.g., a heavier model for
# the offline batch pass and a lighter one during live probing.
export SUMMARY_MODEL="llama3.2"

# ─── Extractor Generator (Optional) ──────────────────────────────────────
# Used by src/analyzer.py to generate Python extractors via code models.
# Leave empty to disable. Requires a code-capable model.
# Good models: qwen2.5-coder:3b, deepseek-coder-v2-light:16b-a14b.
export EXTRACTOR_GENERATOR_URL=""
export EXTRACTOR_GENERATOR_MODEL=""

# ─── Pipeline Runtime Tuning ─────────────────────────────────────────────
# Seconds between probes during full sweeps
export PROBE_DELAY=8

# Seconds between probes for reachable-only health checks
export PROBE_REACHABLE_DELAY=3

# Hours before a site is considered "stale" and re-probed
export STALE_HOURS=24

# Max sites per deep analysis run (0 = all pending)
export ANALYSIS_LIMIT=0

# Max summaries per translation run (0 = all pending)
export TRANSLATE_LIMIT=0
