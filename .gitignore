__pycache__/
*.py[cod]
*.so
.venv/
.DS_Store

# Runtime database — recreated on demand
indexer.db
indexer.db-shm
indexer.db-wal

# Pipeline logs (runtime artifacts)
logs/

# Probe results / scraped content (runtime output)
results/

# Addressbook and seed data (contains I2P identity data)
data/

# Hermes internal files
.hermes/

# Git worktrees created by kanban tasks
.worktrees/

# Ad-hoc scripts/tools (not part of the library)
scripts/

# Generated website output (regenerated after each sweep)
website/

# Auto-generated extractor plugins (runtime artifacts; copy reusable ones to src/ manually)
# The built-in HtmlExtractor is versioned and tracked
src/ext_plugins/*.py
!src/ext_plugins/html_extractor.py
!src/ext_plugins/__init__.py

# UV lock file
uv.lock

# ML model weights — downloaded at runtime via huggingface_hub or Ollama
models/

# Test database (runtime artifact)
tests/discoveries.db
tests/*.db

# Benchmark scripts — local performance measurements, not part of the library
benchmark*.py
*benchmark*.py
